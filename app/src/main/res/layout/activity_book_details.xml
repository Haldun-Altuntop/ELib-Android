<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_book_details_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    tools:context=".BookDetailsActivity">

    <ImageView
        android:id="@+id/activity_book_details_image"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        app:layout_constraintTop_toTopOf="@id/activity_book_details_main"
        app:layout_constraintStart_toStartOf="@id/activity_book_details_main"
        android:src="@color/teal_200" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/activity_book_details_btn_back"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/baseline_arrow_back_24"
        app:shapeAppearanceOverlay="@style/CircularImage"
        android:background="@color/white"
        app:layout_constraintStart_toStartOf="@id/activity_book_details_main"
        app:layout_constraintTop_toTopOf="@id/activity_book_details_main"
        android:layout_margin="8dp" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/activity_book_details_btn_more"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/baseline_more_horiz_24"
        app:shapeAppearanceOverlay="@style/CircularImage"
        android:background="@color/white"
        app:layout_constraintEnd_toEndOf="@id/activity_book_details_main"
        app:layout_constraintTop_toTopOf="@id/activity_book_details_main"
        android:layout_margin="8dp" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:cardCornerRadius="20dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomAppBar"
        app:layout_constraintTop_toBottomOf="@+id/activity_book_details_image">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/activity_book_details_tv_bookname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kitap adı"
                    android:textColor="@color/black"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/activity_book_details_tv_author"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Yazar adı"
                    android:textColor="#717171"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:paddingBottom="10dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/activity_book_details_tv_bookname" />

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="10dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#69FFEB3B"
                        android:padding="10dp"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/star"/>

                        <TextView
                            android:id="@+id/activity_book_details_tv_rating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="123"/>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    app:cardCornerRadius="8dp"
                    android:layout_weight="1"
                    android:layout_margin="5dp"
                    app:cardBackgroundColor="#F4F4F4">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SAYFA" />

                        <TextView
                            android:id="@+id/activity_book_details_tv_page"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:textSize="20sp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    app:cardCornerRadius="8dp"
                    android:layout_weight="1"
                    android:layout_margin="5dp"
                    app:cardBackgroundColor="#F4F4F4">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TÜR" />

                        <TextView
                            android:id="@+id/activity_book_details_tv_type"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Roman"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:textSize="20sp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    app:cardCornerRadius="8dp"
                    android:layout_weight="1"
                    android:layout_margin="5dp"
                    app:cardBackgroundColor="#F4F4F4">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="YIL" />

                        <TextView
                            android:id="@+id/activity_book_details_tv_publication"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2025"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:textSize="20sp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Özet"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="20sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/black"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"/>

                <TextView
                    android:id="@+id/activity_book_details_tv_ozet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kitabın uzuncana bir özeti" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/bottomAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        app:layout_constraintBottom_toBottomOf="@id/activity_book_details_main">

        <ImageButton
            android:id="@+id/activity_book_details_btn_bookmark"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/bookmark_filled"
            app:tint="@color/black" />

        <Button
            style="@style/Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ödünç Al" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>