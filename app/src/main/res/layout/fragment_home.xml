<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    tools:context=".HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:textStyle="bold"
                android:paddingTop="20dp"
                android:textColor="#9E9E9E"
                android:text="Günaydın," />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:paddingStart="16dp"
                android:paddingTop="0dp"
                android:textSize="30sp"
                android:text="Listede ne var?" />

        </LinearLayout>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/fragment_home_profile_image"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="8dp"
            android:scaleType="centerCrop"
            android:background="#B1B1B1"
            android:src="@drawable/person"
            app:shapeAppearanceOverlay="@style/CircularImage"/>

    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/white">

        <SearchView
            android:id="@+id/fragment_home_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:iconifiedByDefault="false"
            app:queryHint="Arama yapın..." />

    </androidx.cardview.widget.CardView>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:clipToPadding="false">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/fragment_home_categories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:selectionRequired="false">

            <com.google.android.material.chip.Chip
                android:id="@+id/fragment_home_categories_story"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="hikaye"
                android:text="Hikaye" />

            <com.google.android.material.chip.Chip
                android:id="@+id/fragment_home_categories_memoir"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="anı"
                android:text="Anı" />

            <com.google.android.material.chip.Chip
                android:id="@+id/fragment_home_categories_documentary"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="belgesel"
                android:text="Belgesel" />

            <com.google.android.material.chip.Chip
                android:id="@+id/fragment_home_categories_essay"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="deneme"
                android:text="Deneme" />

            <com.google.android.material.chip.Chip
                android:id="@+id/fragment_home_categories_novel"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="roman"
                android:text="Roman" />

            <com.google.android.material.chip.Chip
                android:id="@+id/fragment_home_categories_literature"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="edebiyat"
                android:text="Edebiyat" />

            <com.google.android.material.chip.Chip
                android:id="@+id/fragment_home_categories_action"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="aksiyon"
                android:text="Aksiyon" />

            <com.google.android.material.chip.Chip
                android:id="@+id/fragment_home_categories_sifi"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="bilim kurgu"
                android:text="Bilim Kurgu" />

            <com.google.android.material.chip.Chip
                android:id="@+id/fragment_home_categories_biography"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="biyografi"
                android:text="Biyografi" />

        </com.google.android.material.chip.ChipGroup>

    </HorizontalScrollView>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/fragment_home_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/fragment_home_progressbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>

    </RelativeLayout>

</LinearLayout>